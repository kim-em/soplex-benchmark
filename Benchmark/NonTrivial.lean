-- Non-trivial Farkas multipliers:
-- Hypotheses cᵢ·xᵢ ≤ 1 for cᵢ = 2..21.
-- Goal: Σ xᵢ ≤ Σ 1/cᵢ.
-- The certificate has multiplier 1/cᵢ on hypothesis i.
import Mathlib.Tactic.Linarith
import Soplex
open Soplex Soplex.Verify

#time
example (x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 : Rat)
    (_a1 : 0 ≤ x1) (_a2 : 0 ≤ x2) (_a3 : 0 ≤ x3) (_a4 : 0 ≤ x4) (_a5 : 0 ≤ x5)
    (_a6 : 0 ≤ x6) (_a7 : 0 ≤ x7) (_a8 : 0 ≤ x8) (_a9 : 0 ≤ x9) (_a10 : 0 ≤ x10)
    (_a11 : 0 ≤ x11) (_a12 : 0 ≤ x12) (_a13 : 0 ≤ x13) (_a14 : 0 ≤ x14) (_a15 : 0 ≤ x15)
    (_a16 : 0 ≤ x16) (_a17 : 0 ≤ x17) (_a18 : 0 ≤ x18) (_a19 : 0 ≤ x19) (_a20 : 0 ≤ x20)
    (_b1 : 2 * x1 ≤ 1) (_b2 : 3 * x2 ≤ 1) (_b3 : 4 * x3 ≤ 1) (_b4 : 5 * x4 ≤ 1)
    (_b5 : 6 * x5 ≤ 1) (_b6 : 7 * x6 ≤ 1) (_b7 : 8 * x7 ≤ 1) (_b8 : 9 * x8 ≤ 1)
    (_b9 : 10 * x9 ≤ 1) (_b10 : 11 * x10 ≤ 1) (_b11 : 12 * x11 ≤ 1) (_b12 : 13 * x12 ≤ 1)
    (_b13 : 14 * x13 ≤ 1) (_b14 : 15 * x14 ≤ 1) (_b15 : 16 * x15 ≤ 1) (_b16 : 17 * x16 ≤ 1)
    (_b17 : 18 * x17 ≤ 1) (_b18 : 19 * x18 ≤ 1) (_b19 : 20 * x19 ≤ 1) (_b20 : 21 * x20 ≤ 1) :
    x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 +
    x11 + x12 + x13 + x14 + x15 + x16 + x17 + x18 + x19 + x20 ≤
    1/2 + 1/3 + 1/4 + 1/5 + 1/6 + 1/7 + 1/8 + 1/9 + 1/10 + 1/11 +
    1/12 + 1/13 + 1/14 + 1/15 + 1/16 + 1/17 + 1/18 + 1/19 + 1/20 + 1/21 := by lp

#time
example (x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 : Rat)
    (_a1 : 0 ≤ x1) (_a2 : 0 ≤ x2) (_a3 : 0 ≤ x3) (_a4 : 0 ≤ x4) (_a5 : 0 ≤ x5)
    (_a6 : 0 ≤ x6) (_a7 : 0 ≤ x7) (_a8 : 0 ≤ x8) (_a9 : 0 ≤ x9) (_a10 : 0 ≤ x10)
